# Optional: OpenTopography API key for DEM download (https://opentopography.org)
# If unset, scripts fall back to a synthetic DEM for Lasam prototype demos.
OPENTOPOGRAPHY_API_KEY=

# Optional: Copernicus Data Space credentials (future)
COPERNICUS_USERNAME=
COPERNICUS_PASSWORD=

# Optional public origin for browser GIS assets (for example Cloudflare R2).
# Leave empty during local development to use files from public/data.
VITE_GIS_BASE_URL=
